# ═══════════════════════════════════════════════════════════
#  ALPHA Platform — Environment Variables Reference
#  Copy to .env and fill in. Never commit actual secrets.
# ═══════════════════════════════════════════════════════════

# ── Backend (Railway) ─────────────────────────────────────────
# Railway injects PORT automatically — do not set manually
PORT=8080

# PostgreSQL connection (from Supabase or Railway Postgres add-on)
DATABASE_URL=jdbc:postgresql://your-db-host:5432/alphadb
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_DRIVER=org.postgresql.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_DDL_AUTO=update

# JWT — generate a new secret: openssl rand -base64 64
JWT_SECRET=your_base64_encoded_secret_here
JWT_EXPIRATION_MS=86400000

# CORS — your Vercel frontend URL (no trailing slash)
CORS_ALLOWED_ORIGINS=https://your-alpha-app.vercel.app

# H2 console (set false in production)
H2_CONSOLE_ENABLED=false

# Log level (INFO or DEBUG)
LOG_LEVEL=INFO

# ── Frontend (Vercel) ─────────────────────────────────────────
# Your Railway backend public URL (from Railway dashboard)
NEXT_PUBLIC_API_URL=https://your-alpha-backend.up.railway.app
